# Copy to .env.local for next dev; scripts load .env.local too.
# Use a NON-OWNER, NOSUPERUSER, NOBYPASSRLS hoa_runtime login.
DATABASE_URL=postgresql://hoa_runtime:CHANGE_ME@127.0.0.1:5432/hoa
DATABASE_TRANSPORT=postgres
# Amplify supplies these non-secret references from backend outputs. Never use
# the migration credential here. The compute IAM role reads the runtime secret.
DATABASE_RESOURCE_ARN=
DATABASE_SECRET_ARN=
DATABASE_NAME=hoa
# Migration/seed credential only; never supply to the web container.
DATABASE_ADMIN_URL=postgresql://hoa_owner:CHANGE_ME@127.0.0.1:5432/hoa
# Only for the optional local compose database. Match the admin URL password.
LOCAL_POSTGRES_PASSWORD=
PLATFORM_ORIGIN=http://localhost:3000
COMMUNITY_BASE_DOMAIN=localhost
# Generate with: openssl rand -hex 32. Required outside local development.
SESSION_SECRET=
AUTH_MODE=cognito
ALLOW_DEV_AUTH=false
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# HTTPS managed-login origin, without a trailing path.
COGNITO_DOMAIN=
# Required-MFA, password-only user pool with verified email and TOTP.
# IAM needs cognito-idp:DescribeUserPool and cognito-idp:AdminGetUser.
# No Stripe, S3, SES, or Cloudflare integration is activated in this phase.
